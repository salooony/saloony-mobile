#!/usr/bin/env sh
set -e

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.md')

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Formatting staged files with Prettier..."
echo "$STAGED_FILES" | tr '\n' '\0' | xargs -0 npx prettier --write
echo "$STAGED_FILES" | tr '\n' '\0' | xargs -0 git add
